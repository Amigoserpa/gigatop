<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Gigatop – Private AI & Local AI Solutions</title>
  <meta name="description" content="Private AI-Infrastruktur. Ihre Daten. Ihre KI. Ihre Kontrolle.">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#0f172a',
            accent: '#3b82f6',
            accentHover: '#2563eb',
            surface: '#1e293b',
            border: '#334155',
            muted: '#94a3b8',
            text: '#e2e8f0'
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Plus Jakarta Sans', 'system-ui', 'sans-serif']
          }
        }
      }
    }
  </script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', system-ui, sans-serif; }
    .hero-bg {
      background: radial-gradient(ellipse at 50% 0%, #1e3a5f 0%, #0f172a 60%, #020617 100%);
    }
    .gradient-border {
      background: linear-gradient(90deg, transparent, rgba(59,130,246,0.3), transparent);
    }
    .fade-in {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .card-hover { transition: transform 0.2s ease, border-color 0.2s ease; }
    .card-hover:hover { transform: translateY(-4px); border-color: #3b82f6; }
  </style>
</head>
<body class="bg-primary text-text antialiased overflow-x-hidden">

  <!-- Navigation -->
  <nav class="fixed top-0 w-full z-50 bg-primary/90 backdrop-blur-md border-b border-border/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="#" class="font-display font-bold text-xl tracking-tight">GIGATOP</a>
        
        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-8">
          <a href="#solutions" class="text-muted hover:text-text transition-colors" data-i18n="nav_solutions">Lösungen</a>
          <a href="#usecases" class="text-muted hover:text-text transition-colors" data-i18n="nav_usecases">Use Cases</a>
          <a href="#architecture" class="text-muted hover:text-text transition-colors" data-i18n="nav_architecture">Architektur</a>
          <a href="#process" class="text-muted hover:text-text transition-colors" data-i18n="nav_process">Prozess</a>
          <a href="#about" class="text-muted hover:text-text transition-colors" data-i18n="nav_about">Über uns</a>
          <button onclick="openModal('contactModal')" class="text-muted hover:text-text transition-colors" data-i18n="nav_contact">Kontakt</button>
          <button onclick="openModal('portalModal')" class="text-muted hover:text-text transition-colors" data-i18n="nav_login">Login</button>
          <select id="langSelect" onchange="setLanguage(this.value)" class="bg-transparent border border-border rounded px-2 py-1 text-sm text-muted cursor-pointer">
            <option value="de">DE</option>
            <option value="en">EN</option>
          </select>
        </div>
        
        <!-- Mobile Menu Button -->
        <button onclick="toggleMobileMenu()" class="md:hidden text-text p-2">
          <svg id="menuIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            <path id="menuClose" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Menu -->
    <div id="mobileMenu" class="hidden md:hidden bg-surface border-t border-border">
      <div class="px-4 py-4 space-y-3">
        <a href="#solutions" class="block text-muted hover:text-text py-2" data-i18n="nav_solutions">Lösungen</a>
        <a href="#usecases" class="block text-muted hover:text-text py-2" data-i18n="nav_usecases">Use Cases</a>
        <a href="#architecture" class="block text-muted hover:text-text py-2" data-i18n="nav_architecture">Architektur</a>
        <a href="#process" class="block text-muted hover:text-text py-2" data-i18n="nav_process">Prozess</a>
        <a href="#about" class="block text-muted hover:text-text py-2" data-i18n="nav_about">Über uns</a>
        <button onclick="openModal('contactModal')" class="block text-muted hover:text-text py-2 text-left w-full" data-i18n="nav_contact">Kontakt</button>
        <button onclick="openModal('portalModal')" class="block text-muted hover:text-text py-2 text-left w-full" data-i18n="nav_login">Login</button>
        <select onchange="setLanguage(this.value)" class="bg-transparent border border-border rounded px-3 py-2 w-full text-sm">
          <option value="de">🇨🇭 Deutsch</option>
          <option value="en">🇬🇧 English</option>
        </select>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero-bg min-h-screen flex items-center justify-center pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <div class="inline-flex items-center gap-2 bg-surface/50 border border-border rounded-full px-4 py-2 mb-8 fade-in">
        <span class="w-2 h-2 bg-green-500 rounded-full"></span>
        <span class="text-sm text-muted" data-i18n="hero_badge">PRIVATE AI • SCHWEIZ</span>
      </div>
      
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl mb-6 fade-in leading-tight">
        <span data-i18n="hero_h1_part1">Your AI.</span>
        <span class="text-accent" data-i18n="hero_h1_part2">Your Data.</span><br>
        <span class="text-muted" data-i18n="hero_h1_part3">Your Infrastructure.</span>
      </h1>
      
      <p class="text-lg sm:text-xl text-muted max-w-2xl mx-auto mb-10 fade-in" data-i18n="hero_subtitle">
        Wir deployen leistungsfähige AI-Systeme, intelligente Agenten und Automationen in Ihrer privaten Infrastruktur. Ihre Daten verlassen niemals Ihre Umgebung.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 fade-in">
        <button onclick="openModal('contactModal')" class="bg-accent hover:bg-accentHover text-white font-semibold py-3 px-8 rounded-lg transition-colors w-full sm:w-auto" data-i18n="hero_cta_primary">
          Kostenloses Gespräch buchen
        </button>
        <button onclick="document.getElementById('usecases').scrollIntoView({behavior:'smooth'})" class="border border-border hover:border-accent text-text py-3 px-8 rounded-lg transition-colors w-full sm:w-auto" data-i18n="hero_cta_secondary">
          Use Cases entdecken
        </button>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 border-b border-border/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center fade-in">
          <div class="text-3xl font-bold text-accent mb-1">100%</div>
          <div class="text-sm text-muted" data-i18n="stat_onprem">On-Premise Capability</div>
        </div>
        <div class="text-center fade-in">
          <div class="text-3xl font-bold text-accent mb-1">0</div>
          <div class="text-sm text-muted" data-i18n="stat_cloud">Cloud Exposure</div>
        </div>
        <div class="text-center fade-in">
          <div class="text-3xl font-bold text-accent mb-1">24/7</div>
          <div class="text-sm text-muted" data-i18n="stat_support">Unterstützung</div>
        </div>
        <div class="text-center fade-in">
          <div class="text-3xl font-bold text-accent mb-1">∞</div>
          <div class="text-sm text-muted" data-i18n="stat_scale">Skalierbarkeit</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Private AI Section -->
  <section id="solutions" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 fade-in">
        <span class="text-accent text-sm font-semibold uppercase tracking-wider" data-i18n="why_label">Warum Private AI</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-3" data-i18n="why_h2">Warum Ihre Daten privat bleiben müssen</h2>
        <p class="text-muted max-w-2xl mx-auto mt-4" data-i18n="why_subtitle">
          Öffentliche KI-Modelle sind nicht für sensible Unternehmensdaten gemacht. Hier ist der Unterschied.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Bad -->
        <div class="bg-red-900/20 border border-red-500/30 rounded-xl p-8 fade-in card-hover">
          <div class="text-2xl mb-4">❌</div>
          <h3 class="font-display font-bold text-xl mb-4 text-red-400" data-i18n="why_bad_h">Öffentliche KI</h3>
          <ul class="space-y-3 text-muted">
            <li class="flex items-start gap-2"><span class="text-red-400">•</span><span data-i18n="why_bad_item1">Ihre Daten werden an externe Provider gesendet</span></li>
            <li class="flex items-start gap-2"><span class="text-red-400">•</span><span data-i18n="why_bad_item2">Training mit Ihren Daten möglich</span></li>
            <li class="flex items-start gap-2"><span class="text-red-400">•</span><span data-i18n="why_bad_item3">Keine Compliance-Garantien</span></li>
            <li class="flex items-start gap-2"><span class="text-red-400">•</span><span data-i18n="why_bad_item4">Abhängigkeit von Drittanbietern</span></li>
          </ul>
        </div>
        
        <!-- Good -->
        <div class="bg-accent/10 border border-accent/30 rounded-xl p-8 fade-in card-hover">
          <div class="text-2xl mb-4">✅</div>
          <h3 class="font-display font-bold text-xl mb-4 text-accent" data-i18n="why_good_h">Gigatop Private AI</h3>
          <ul class="space-y-3 text-muted">
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span data-i18n="why_good_item1">Daten verbleiben in Ihrer Infrastruktur</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span data-i18n="why_good_item2">Vollständige Kontrolle über Modelle & Daten</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span data-i18n="why_good_item3">Compliance-fähig (FADP, GDPR, NIS2)</span></li>
            <li class="flex items-start gap-2"><span class="text-accent">•</span><span data-i18n="why_good_item4">Keine Vendor-Lock-in Gefahr</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section id="usecases" class="py-20 bg-surface/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 fade-in">
        <span class="text-accent text-sm font-semibold uppercase tracking-wider" data-i18n="uc_label">Anwendungsfälle</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-3" data-i18n="uc_h2">KI, die tatsächlich arbeitet</h2>
        <p class="text-muted max-w-2xl mx-auto mt-4" data-i18n="uc_subtitle">
          Keine Demos. Kein Blabla. Wir bauen KI um messbare Geschäftsprobleme zu lösen.
        </p>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Use Case 1 -->
        <div class="bg-surface border border-border rounded-xl p-6 fade-in card-hover">
          <div class="text-3xl mb-4">🏥</div>
          <div class="text-xs text-accent font-semibold uppercase mb-2" data-i18n="uc1_tag">Gesundheit & Leistung</div>
          <h3 class="font-display font-bold text-lg mb-2" data-i18n="uc1_title">AI Gesundheitscoach</h3>
          <p class="text-muted text-sm" data-i18n="uc1_desc">Privater Gesundheitsassistent mit Zugriff auf Patientendaten – lokal und sicher.</p>
        </div>
        
        <!-- Use Case 2 -->
        <div class="bg-surface border border-border rounded-xl p-6 fade-in card-hover">
          <div class="text-3xl mb-4">💼</div>
          <div class="text-xs text-accent font-semibold uppercase mb-2" data-i18n="uc2_tag">Vertrieb & Business</div>
          <h3 class="font-display font-bold text-lg mb-2" data-i18n="uc2_title">AI Lead-Intelligenz</h3>
          <p class="text-muted text-sm" data-i18n="uc2_desc">Verkaufs-Assistent der Leads analysiert, priorisiert und personalisiert kontaktiert.</p>
        </div>
        
        <!-- Use Case 3 -->
        <div class="bg-surface border border-border rounded-xl p-6 fade-in card-hover">
          <div class="text-3xl mb-4">📚</div>
          <div class="text-xs text-accent font-semibold uppercase mb-2" data-i18n="uc3_tag">Wissen</div>
          <h3 class="font-display font-bold text-lg mb-2" data-i18n="uc3_title">Private Unternehmens-KI</h3>
          <p class="text-muted text-sm" data-i18n="uc3_desc">Wissensdatenbank die auf Ihre internen Dokumente zugreift und intelligente Antworten gibt.</p>
        </div>
        
        <!-- Use Case 4 -->
        <div class="bg-surface border border-border rounded-xl p-6 fade-in card-hover">
          <div class="text-3xl mb-4">📄</div>
          <div class="text-xs text-accent font-semibold uppercase mb-2" data-i18n="uc4_tag">Dokumente</div>
          <h3 class="font-display font-bold text-lg mb-2" data-i18n="uc4_title">AI Dokumentenverwaltung</h3>
          <p class="text-muted text-sm" data-i18n="uc4_desc">Automatisierte Dokumentenerstellung, Zusammenfassung und Klassifizierung.</p>
        </div>
        
        <!-- Use Case 5 -->
        <div class="bg-surface border border-border rounded-xl p-6 fade-in card-hover">
          <div class="text-3xl mb-4">⚙️</div>
          <div class="text-xs text-accent font-semibold uppercase mb-2" data-i18n="uc5_tag">Geschäftsführung</div>
          <h3 class="font-display font-bold text-lg mb-2" data-i18n="uc5_title">AI Geschäftsführer-Intelligenz</h3>
          <p class="text-muted text-sm" data-i18n="uc5_desc">Decision-Support-System das Daten analysiert und Handlungsempfehlungen gibt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture Section -->
  <section id="architecture" class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 fade-in">
        <span class="text-accent text-sm font-semibold uppercase tracking-wider" data-i18n="arch_label">Architektur</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-3" data-i18n="arch_h2">Ihre Daten. Ihre KI-Schicht.</h2>
        <p class="text-muted max-w-2xl mx-auto mt-4" data-i18n="arch_subtitle">
          Gigatop verbindet Ihr Team, Ihre Daten und Ihre KI – alles in Ihrer Infrastruktur.
        </p>
      </div>
      
      <div class="space-y-6 max-w-3xl mx-auto">
        <!-- Layer 1 -->
        <div class="bg-surface border border-border rounded-lg p-5 flex items-center gap-4 fade-in card-hover">
          <div class="bg-accent/20 text-accent font-bold w-24 h-24 rounded-lg flex items-center justify-center text-sm shrink-0">Ebene 1</div>
          <div>
            <h3 class="font-bold" data-i18n="arch_l1_h">Zugriff & Integration</h3>
            <p class="text-sm text-muted" data-i18n="arch_l1_p">API-Schnittstellen, Authentifizierung und Zugriffskontrolle für Ihr gesamtes System.</p>
          </div>
        </div>
        
        <!-- Layer 2 -->
        <div class="bg-surface border border-border rounded-lg p-5 flex items-center gap-4 fade-in card-hover">
          <div class="bg-accent/20 text-accent font-bold w-24 h-24 rounded-lg flex items-center justify-center text-sm shrink-0">Ebene 2</div>
          <div>
            <h3 class="font-bold" data-i18n="arch_l2_h">Gigatop KI-Schicht</h3>
            <p class="text-sm text-muted" data-i18n="arch_l2_p">KI-Modelle, Agenten, Reasoning-Engines und Workflows – vollständig kontrolliert.</p>
          </div>
        </div>
        
        <!-- Layer 3 -->
        <div class="bg-surface border border-border rounded-lg p-5 flex items-center gap-4 fade-in card-hover">
          <div class="bg-accent/20 text-accent font-bold w-24 h-24 rounded-lg flex items-center justify-center text-sm shrink-0">Ebene 3</div>
          <div>
            <h3 class="font-bold" data-i18n="arch_l3_h">Unternehmensdaten</h3>
            <p class="text-sm text-muted" data-i18n="arch_l3_p">CRM, ERP, Dokumente, Datenbanken – alles lokal und sicher.</p>
          </div>
        </div>
        
        <!-- Layer 4 -->
        <div class="bg-surface border border-border rounded-lg p-5 flex items-center gap-4 fade-in card-hover">
          <div class="bg-accent/20 text-accent font-bold w-24 h-24 rounded-lg flex items-center justify-center text-sm shrink-0">Ebene 4</div>
          <div>
            <h3 class="font-bold" data-i18n="arch_l4_h">Infrastruktur</h3>
            <p class="text-sm text-muted" data-i18n="arch_l4_p">On-Premise, Private Cloud oder Hybrid – Ihre Wahl, unsere Umsetzung.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section id="process" class="py-20 bg-surface/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 fade-in">
        <span class="text-accent text-sm font-semibold uppercase tracking-wider" data-i18n="process_label">Prozess</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-3" data-i18n="process_h2">Von der Idee zur Produktion</h2>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <div class="text-center fade-in card-hover">
          <div class="bg-surface border border-border rounded-full w-12 h-12 mx-auto mb-4 flex items-center justify-center font-bold text-accent">1</div>
          <h3 class="font-bold mb-2" data-i18n="process_1_h">Entdecken</h3>
          <p class="text-sm text-muted" data-i18n="process_1_p">Prozesse, Daten und mögliche AI-Anwendungsfälle analysieren.</p>
        </div>
        <div class="text-center fade-in card-hover">
          <div class="bg-surface border border-border rounded-full w-12 h-12 mx-auto mb-4 flex items-center justify-center font-bold text-accent">2</div>
          <h3 class="font-bold mb-2" data-i18n="process_2_h">Prototyp</h3>
          <p class="text-sm text-muted" data-i18n="process_2_p">Ein funktionierender Proof of Concept zeigt echten Mehrwert.</p>
        </div>
        <div class="text-center fade-in card-hover">
          <div class="bg-surface border border-border rounded-full w-12 h-12 mx-auto mb-4 flex items-center justify-center font-bold text-accent">3</div>
          <h3 class="font-bold mb-2" data-i18n="process_3_h">Verknüpfen</h3>
          <p class="text-sm text-muted" data-i18n="process_3_p">Datenquellen, APIs und Systeme verbinden.</p>
        </div>
        <div class="text-center fade-in card-hover">
          <div class="bg-surface border border-border rounded-full w-12 h-12 mx-auto mb-4 flex items-center justify-center font-bold text-accent">4</div>
          <h3 class="font-bold mb-2" data-i18n="process_4_h">Bereitstellen</h3>
          <p class="text-sm text-muted" data-i18n="process_4_p">KI on-premise, private-cloud oder gehostet deployen.</p>
        </div>
        <div class="text-center fade-in card-hover">
          <div class="bg-surface border border-border rounded-full w-12 h-12 mx-auto mb-4 flex items-center justify-center font-bold text-accent">5</div>
          <h3 class="font-bold mb-2" data-i18n="process_5_h">Verbessern</h3>
          <p class="text-sm text-muted" data-i18n="process_5_p">Agenten, Modelle und Workflows kontinuierlich optimieren.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Deployment Options -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 fade-in">
        <span class="text-accent text-sm font-semibold uppercase tracking-wider" data-i18n="deploy_label">Bereitstellung</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-3" data-i18n="deploy_h2">Ihre Daten. Ihre Wahl.</h2>
        <p class="text-muted max-w-2xl mx-auto mt-4" data-i18n="deploy_p">
          Von vollständig on-premise bis zu flexiblen gehosteten Optionen. Immer unter Ihrer Kontrolle.
        </p>
      </div>
      
      <div class="grid sm:grid-cols-3 gap-6">
        <!-- Option 1 -->
        <div class="bg-surface border border-border rounded-xl p-6 fade-in card-hover">
          <div class="text-2xl mb-4">🖥️</div>
          <h3 class="font-bold mb-2" data-i18n="deploy1_h">Private KI</h3>
          <div class="text-xs text-accent mb-3" data-i18n="deploy1_sub">Am privatest</div>
          <p class="text-sm text-muted mb-4" data-i18n="deploy1_p">KI läuft in Ihrer Infrastruktur. Ihre Modelle, Ihre Daten, Ihre Kontrolle.</p>
          <ul class="text-sm text-muted space-y-2">
            <li data-i18n="deploy1_f1">Sensible Unternehmensdaten</li>
            <li data-i18n="deploy1_f2">Gesundheitswesen & Finanzen</li>
            <li data-i18n="deploy1_f3">Juristischer & IP-Schutz</li>
          </ul>
        </div>
        
        <!-- Option 2 -->
        <div class="bg-surface border border-accent/40 rounded-xl p-6 fade-in card-hover relative">
          <div class="absolute -top-3 right-4 bg-accent text-white text-xs font-bold px-3 py-1 rounded-full" data-i18n="deploy_rec">EMPFOHLEN</div>
          <div class="text-2xl mb-4">☁️</div>
          <h3 class="font-bold mb-2" data-i18n="deploy2_h">Private Gehostet</h3>
          <div class="text-xs text-accent mb-3" data-i18n="deploy2_sub">Flexibel</div>
          <p class="text-sm text-muted mb-4" data-i18n="deploy2_p">Dedizierte Umgebung verwaltet von Gigatop. Keine lokale GPU nötig.</p>
          <ul class="text-sm text-muted space-y-2">
            <li data-i18n="deploy2_f1">Keine lokale GPU</li>
            <li data-i18n="deploy2_f2">Verwaltete Infrastruktur</li>
            <li data-i18n="deploy2_f3">Skalierbare Ressourcen</li>
          </ul>
        </div>
        
        <!-- Option 3 -->
        <div class="bg-surface border border-border rounded-xl p-6 fade-in card-hover">
          <div class="text-2xl mb-4">🔗</div>
          <h3 class="font-bold mb-2" data-i18n="deploy3_h">Hybride KI</h3>
          <div class="text-xs text-accent mb-3" data-i18n="deploy3_sub">Bestes aus beiden</div>
          <p class="text-sm text-muted mb-4" data-i18n="deploy3_p">Lokale Datenverarbeitung kombiniert mit ausgewählten externen KI-Services.</p>
          <ul class="text-sm text-muted space-y-2">
            <li data-i18n="deploy3_f1">Gemischte Workloads</li>
            <li data-i18n="deploy3_f2">Unterschiedliche Modelle</li>
            <li data-i18n="deploy3_f3">Maximale Flexibilität</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-20 bg-surface/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 fade-in">
        <span class="text-accent text-sm font-semibold uppercase tracking-wider" data-i18n="about_label">Über uns</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-3" data-i18n="about_h2">Wir bauen KI, die in der realen Welt funktioniert</h2>
        <p class="text-muted max-w-2xl mx-auto mt-4" data-i18n="about_p">
          Gigatop hilft Unternehmen, von AI-Experimenten zu produktiven Systemen zu gehen. Wir verbinden private KI-Infrastruktur, intelligente Agenten, Automation und Geschäftsverständnis.
        </p>
      </div>
      
      <div class="max-w-3xl mx-auto text-center fade-in">
        <blockquote class="text-xl italic text-muted border-l-4 border-accent pl-6 py-4" data-i18n="about_quote">
          "KI sollte sich an Ihr Geschäft anpassen. Ihr Geschäft sollte sich nicht an KI anpassen müssen."
        </blockquote>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center fade-in">
      <div class="bg-gradient-to-br from-accent/20 to-transparent border border-accent/30 rounded-2xl p-10">
        <span class="text-accent text-sm font-semibold uppercase tracking-wider" data-i18n="cta_label">Loslegen</span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl mt-4 mb-4" data-i18n="cta_h2">Ihr Unternehmen hat bereits die Daten.</h2>
        <p class="text-muted mb-8" data-i18n="cta_p">Buchen Sie ein kostenloses Discovery-Call. Wir zeigen Ihnen, was KI für Ihr Business tun kann.</p>
        <button onclick="openModal('contactModal')" class="bg-accent hover:bg-accentHover text-white font-semibold py-3 px-8 rounded-lg transition-colors" data-i18n="cta_btn">Kostenloses Gespräch buchen</button>
        <p class="text-xs text-muted mt-4" data-i18n="cta_privacy">Private KI • Schweiz</p>
      </div>
    </div>
  </section>

