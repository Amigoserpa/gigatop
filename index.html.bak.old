  <!-- Contact Modal -->
  <div id="contactModal" class="fixed inset-0 z-[60] hidden items-center justify-center p-4" onclick="closeModal(event, 'contactModal')">
    <div class="absolute inset-0 bg-black/70" onclick="closeModal(event, 'contactModal')"></div>
    <div class="relative bg-surface border border-border rounded-xl p-6 max-w-md w-full max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
      <button onclick="closeModal(null, 'contactModal')" class="absolute top-4 right-4 text-muted hover:text-text">&times;</button>
      <h3 class="font-display font-bold text-xl mb-2" data-i18n="contact_h">Termin buchen</h3>
      <p class="text-sm text-muted mb-6" data-i18n="contact_p">Erzählen Sie uns von Ihrem Use Case.</p>
      
      <form id="contactForm" onsubmit="submitContact(event)" class="space-y-4">
        <div>
          <label class="block text-sm mb-1" data-i18n="contact_name">Name *</label>
          <input type="text" name="name" required placeholder="Ihr Name" class="w-full bg-primary border border-border rounded-lg px-3 py-2 text-sm focus:border-accent outline-none">
        </div>
        <div>
          <label class="block text-sm mb-1" data-i18n="contact_company">Unternehmen</label>
          <input type="text" name="company" placeholder="Ihr Unternehmen" class="w-full bg-primary border border-border rounded-lg px-3 py-2 text-sm focus:border-accent outline-none">
        </div>
        <div>
          <label class="block text-sm mb-1" data-i18n="contact_email">E-Mail *</label>
          <input type="email" name="email" required placeholder="ihre@email.ch" class="w-full bg-primary border border-border rounded-lg px-3 py-2 text-sm focus:border-accent outline-none">
        </div>
        <div>
          <label class="block text-sm mb-1" data-i18n="contact_uc">Use Case</label>
          <select name="usecase" class="w-full bg-primary border border-border rounded-lg px-3 py-2 text-sm focus:border-accent outline-none">
            <option value="" data-i18n="contact_uc_ph">Wählen...</option>
            <option value="gesundheit">Gesundheit</option>
            <option value="vertrieb">Vertrieb & Business</option>
            <option value="wissen">Unternehmens-Wissen</option>
            <option value="dokumente">Dokumenten-Management</option>
            <option value="gf">Geschäftsführung</option>
            <option value="other">Sonstiges</option>
          </select>
        </div>
        <div>
          <label class="block text-sm mb-1" data-i18n="contact_msg">Nachricht</label>
          <textarea name="message" rows="4" placeholder="Ihre Nachricht..." class="w-full bg-primary border border-border rounded-lg px-3 py-2 text-sm focus:border-accent outline-none"></textarea>
        </div>
        <button type="submit" class="w-full bg-accent hover:bg-accentHover text-white font-semibold py-2 px-4 rounded-lg transition-colors">
          <span id="contactBtnText" data-i18n="contact_send">Anfrage senden</span>
          <span id="contactBtnLoading" class="hidden">⏳</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Portal Modal -->
  <div id="portalModal" class="fixed inset-0 z-[60] hidden items-center justify-center p-4" onclick="closeModal(event, 'portalModal')">
    <div class="absolute inset-0 bg-black/70" onclick="closeModal(event, 'portalModal')"></div>
    <div class="relative bg-surface border border-border rounded-xl p-6 max-w-md w-full max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
      <button onclick="closeModal(null, 'portalModal')" class="absolute top-4 right-4 text-muted hover:text-text">&times;</button>
      <h3 class="font-display font-bold text-xl mb-2" data-i18n="portal_h">Portal Login</h3>
      <p class="text-sm text-muted mb-6" data-i18n="portal_p">Melden Sie sich bei Ihrem Gigatop Dashboard an.</p>
      
      <div class="space-y-3 mb-6">
        <button class="w-full flex items-center justify-center gap-2 bg-white hover:bg-gray-100 text-gray-800 font-medium py-2 px-4 rounded-lg transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          <span data-i18n="portal_google">Weiter mit Google</span>
        </button>
        <button class="w-full flex items-center justify-center gap-2 bg-black hover:bg-gray-800 text-white font-medium py-2 px-4 rounded-lg transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="white" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.05 7.59 9.05 7.31c1.35.07 2.29.74 3.08.74 1.18 0 2.45-1.23 4.36-.85.75.16 2.54.68 3.22 1.78-2.88 1.53-2.37 5.98.35 7.33-.46 1.16-1.1 2.3-2.01 3.97zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          <span data-i18n="portal_apple">Weiter mit Apple</span>
        </button>
        <button class="w-full flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="white" d="M4 4h16v16H4V4zm2 2v12h12V6H6zm2 2h8v2H8V8zm0 4h5v2H8v-2z"/></svg>
          <span data-i18n="portal_microsoft">Weiter mit Microsoft 365</span>
        </button>
      </div>
      
      <button onclick="closeModal(null, 'portalModal')" class="w-full text-center text-muted hover:text-text text-sm" data-i18n="portal_back">← Zurück zur Website</button>
    </div>
  </div>

