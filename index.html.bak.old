    };

    // === i18n Functions ===
    function applyTranslation(lang) {
      try {
        var dict = LANGS[lang];
        if (!dict) { console.error('i18n: No language:', lang); return; }
        
        var els = document.querySelectorAll('[data-i18n]');
        var count = 0;
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          var key = el.getAttribute('data-i18n');
          if (key && dict[key] !== undefined) {
            var val = dict[key];
            if (val.indexOf('<') !== -1) { el.innerHTML = val; }
            else { el.textContent = val; }
            count++;
          }
        }
        console.log('i18n: Translated', count, 'elements to', lang);
        var sel = document.getElementById('langSelect');
        if (sel) sel.value = lang;
        localStorage.setItem('gigatop-lang', lang);
        document.documentElement.lang = lang;
      } catch(e) { console.error('i18n error:', e); }
    }

    window.setLanguage = function(lang) {
      applyTranslation(lang);
      return false;
    };

    // Init on DOM ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        var saved = localStorage.getItem('gigatop-lang');
        if (saved && LANGS[saved]) { applyTranslation(saved); return; }
        var bl = navigator.language || navigator.userLanguage || '';
        applyTranslation(bl.indexOf('de') === 0 ? 'de' : 'en');
      });
    } else {
      var saved = localStorage.getItem('gigatop-lang');
      if (saved && LANGS[saved]) { applyTranslation(saved); return; }
      var bl = navigator.language || navigator.userLanguage || '';
      applyTranslation(bl.indexOf('de') === 0 ? 'de' : 'en');
    }
  </script>

  <!-- Mobile Menu & Modal Logic -->
  <script>
    function toggleMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      const open = document.getElementById('menuOpen');
      const close = document.getElementById('menuClose');
      menu.classList.toggle('hidden');
      open.classList.toggle('hidden');
      close.classList.toggle('hidden');
    }

    function openModal(id) {
      const modal = document.getElementById(id);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal(e, id) {
      if (e && e.target !== e.currentTarget) return;
      const modal = document.getElementById(id);
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    // Scroll animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

    // Contact form
    document.getElementById('contactForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const form = e.target;
      const btnText = document.getElementById('contactBtnText');
      const btnLoading = document.getElementById('contactBtnLoading');
      
      btnText.style.display = 'none';
      btnLoading.classList.remove('hidden');

      const data = new FormData(form);
      const body = {
        _subject: '[Website] Inquiry from ' + data.get('name'),
        name: data.get('name'),
        email: data.get('email'),
        company: data.get('company'),
        usecase: data.get('usecase'),
        message: data.get('message'),
        _template: 'table'
      };

      fetch('https://formsubmit.co/ajax/top@gigatop.io', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body)
      })
      .then(res => res.json())
      .then(() => {
        btnText.textContent = '✓ Gesendet!';
        btnText.style.display = '';
        btnLoading.classList.add('hidden');
        form.reset();
        setTimeout(() => closeModal(null, 'contactModal'), 2000);
      })
      .catch(() => {
        btnText.textContent = '✗ Fehler';
        btnText.style.display = '';
        btnLoading.classList.add('hidden');
      });
    });
  </script>
</body>
</html>